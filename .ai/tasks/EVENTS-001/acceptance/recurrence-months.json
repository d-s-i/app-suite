{
  "name": "EVENTS-001-F04 Select free monthly recurrence patterns",
  "background": [
    {
      "keyword": "Given",
      "text": "the calendar contains no events"
    },
    {
      "keyword": "And",
      "text": "the phone time zone is UTC"
    },
    {
      "keyword": "And",
      "text": "the phone language is English United States"
    },
    {
      "keyword": "And",
      "text": "the phone uses 24-hour time"
    }
  ],
  "scenarios": [
    {
      "name": "EVENTS-001-S16 Repeat a freely chosen numbered day without date drift",
      "steps": [
        {
          "keyword": "When",
          "text": "the owner creates all-day Course from \u003clower_bound\u003e every \u003cinterval\u003e months on day \u003cmonth_day\u003e ending after 3 occurrences",
          "parameters": [
            "lower_bound",
            "interval",
            "month_day"
          ]
        },
        {
          "keyword": "Then",
          "text": "the calendar returns to the originating view on the first occurrence date \u003cfirst_date\u003e",
          "parameters": [
            "first_date"
          ]
        },
        {
          "keyword": "And",
          "text": "Course is all-day on exactly \u003cfirst_date\u003e, \u003csecond_date\u003e and \u003cthird_date\u003e",
          "parameters": [
            "first_date",
            "second_date",
            "third_date"
          ]
        },
        {
          "keyword": "And",
          "text": "its monthly rule still requests day \u003cmonth_day\u003e",
          "parameters": [
            "month_day"
          ]
        }
      ],
