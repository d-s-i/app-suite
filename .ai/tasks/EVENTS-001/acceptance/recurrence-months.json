    {
      "name": "EVENTS-001-S18 Reject a monthly window with no matching occurrence",
      "steps": [
        {
          "keyword": "Given",
          "text": "the owner opened event creation with + for Course from 2027-01-20"
        },
        {
          "keyword": "When",
          "text": "the owner selects every 2 months on the first Monday ending on 2027-01-31 and attempts to save"
        },
        {
          "keyword": "Then",
          "text": "the form identifies that no occurrence fits before the end date"
        },
        {
